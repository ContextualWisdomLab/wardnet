# Fixed upstream; callers cannot choose or redirect this destination.
LITELLM_UPSTREAM_URL=https://llm-gateway-dev.hyosungitx.com

# Place the proxy behind the organization's TLS ingress or bind a private address.
LITELLM_PROXY_BIND_ADDR=127.0.0.1:8090

# 16 MiB supports ordinary OpenAI-compatible JSON and bounded multimodal payloads.
LITELLM_MAX_BODY_BYTES=16777216

# Bounds connection establishment without imposing a total timeout on SSE streams.
LITELLM_CONNECT_TIMEOUT_SECONDS=10
